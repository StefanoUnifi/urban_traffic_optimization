<?xml version="1.0" encoding="UTF-8"?>
<!--File per la configurazione delle strade e veicoli-->
<routes>
    <vType id="auto" accel="2.6" decel="5.0" sigma="0.5" length="5" minGap="2.5" maxSpeed="13.89"/>

    <!-- Definizione dei percorsi -->
    <!-- Input flusso da Nord centrale-->
    <flow id="flusso_N" type="auto" begin="0" end="10000" period="16">
            <routeDistribution>
                <route edges="J0_nord_in J3_nord_in" probability="0.5"/>
                <route edges="J0_nord_in J4_est_in J7_est_in" probability="0.25"/>
                <route edges="J0_nord_in J2_ovest_in J10_ovest_in" probability="0.25"/>
            </routeDistribution>
    </flow>

    <!-- Input flusso da Sud centrale-->
    <flow id="flusso_S" type="auto" begin="0" end="10000" period="16">
            <routeDistribution>
                <route edges="J0_sud_in J1_sud_in" probability="0.5"/>
                <route edges="J0_sud_in J4_est_in J7_est_in" probability="0.25"/>
                <route edges="J0_sud_in J2_ovest_in J10_ovest_in" probability="0.25"/>
            </routeDistribution>
    </flow>

    <!-- Input flusso da Est-->
    <flow id="flusso_E" type="auto" begin="0" end="10000" period="13">
            <routeDistribution>
                <route edges="J2_est_in J0_est_in J4_est_in J7_est_in" probability="0.4"/>
                <route edges="J2_est_in J9_sud_in" probability="0.2"/>
                <route edges="J2_est_in J11_nord_in" probability="0.2"/>
                <route edges="J2_est_in J0_est_in J3_nord_in" probability="0.2"/>
            </routeDistribution>
    </flow>

    <!-- Input flusso da Ovest-->
    <flow id="flusso_O" type="auto" begin="0" end="10000" period="13">
            <routeDistribution>
                <route edges="J4_ovest_in J0_ovest_in J2_ovest_in J10_ovest_in" probability="0.4"/>
                <route edges="J4_ovest_in J5_sud_in" probability="0.2"/>
                <route edges="J4_ovest_in J8_nord_in" probability="0.2"/>
                <route edges="J4_ovest_in J0_ovest_in J1_sud_in" probability="0.2"/>
            </routeDistribution>
    </flow>

    <!-- Input flusso da Nord sinistra-->
    <flow id="flusso_NO" type="auto" begin="0" end="10000" period="18">
            <routeDistribution>
                <route edges="J4_nord_in J7_est_in" probability="0.33"/>
                <route edges="J4_nord_in J8_nord_in" probability="0.34"/>
                <route edges="J4_nord_in J0_ovest_in J2_ovest_in J10_ovest_in" probability="0.33"/>
            </routeDistribution>
    </flow>

    <!-- Input flusso da Nord destra-->
    <flow id="flusso_NE" type="auto" begin="0" end="10000" period="18">
            <routeDistribution>
                <route edges="J2_nord_in J11_nord_in" probability="0.34"/>
                <route edges="J2_nord_in J10_ovest_in" probability="0.33"/>
                <route edges="J2_nord_in J0_est_in J4_est_in J7_est_in" probability="0.33"/>
            </routeDistribution>
    </flow>

    <!-- Input flusso da Sud sinistra-->
    <flow id="flusso_SO" type="auto" begin="0" end="10000" period="18">
            <routeDistribution>
                <route edges="J4_sud_in J5_sud_in" probability="0.34"/>
                <route edges="J4_sud_in J7_est_in" probability="0.33"/>
                <route edges="J4_sud_in J0_ovest_in J2_ovest_in J10_ovest_in" probability="0.33"/>
            </routeDistribution>
    </flow>

    <!-- Input flusso da Sud destra-->
    <flow id="flusso_SE" type="auto" begin="0" end="10000" period="18">
            <routeDistribution>
                <route edges="J2_sud_in J9_sud_in" probability="0.34"/>
                <route edges="J2_sud_in J10_ovest_in" probability="0.33"/>
                <route edges="J2_sud_in J0_est_in J4_est_in J7_est_in" probability="0.33"/>
            </routeDistribution>
    </flow>

    <flow id="picco_ovest" type="auto" begin="1200" end="3000" period="6">
        <routeDistribution>
            <route edges="J4_ovest_in J0_ovest_in J2_ovest_in J10_ovest_in" probability="1.0"/>
        </routeDistribution>
    </flow>
</routes>